      },
      "risk": {
        "max_concurrent": 12,
        "max_daily_loss_cents": 8000,
        "halt_after_n_losses": 6
      },
      "schedule": {
        "active_hours_utc": [[0, 24]],
        "active_days": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
      }
    }
  },
  {
    "id": "tpl_dca_weekly",
    "name": "Weekly DCA",
    "category": "DCA",
    "description": "Buys a fixed notional every Monday at 14:00 UTC. No stop-loss — accumulates regardless of price.",
    "risk_level": 2,
    "asset_filter": { "symbols": [0], "market": "qftx" },
    "strategy": {
      "version": 1,
      "entry": {
        "all_of": [
          {
            "type": "indicator_threshold",
            "indicator": "schedule_tick",
            "params": { "cron": "0 14 * * 1" },
            "op": "eq",
            "value": 1.0
          }
        ]
      },
      "exit": {
        "any_of": []
      },
      "position_sizing": {
        "kind": "fixed_amount",
        "value_cents": 10000
      },
      "risk": {
        "max_concurrent": 1,
        "max_daily_loss_cents": 100000,
        "halt_after_n_losses": 999
      },
      "schedule": {
        "active_hours_utc": [[14, 15]],
        "active_days": ["Mon"]
      }
    }
  }
]

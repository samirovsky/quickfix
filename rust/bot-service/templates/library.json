[
  {
    "id": "tpl_rsi_oversold",
    "name": "RSI Oversold Bounce",
    "category": "MeanReversion",
    "description": "Buys when RSI(14) on the 1h chart drops below 30. Exits on a 2% take-profit or a 1% stop-loss.",
    "risk_level": 3,
    "asset_filter": { "symbols": [0], "market": "qftx" },
    "strategy": {
      "version": 1,
      "entry": {
        "all_of": [
          {
            "type": "indicator_threshold",
            "indicator": "rsi",
            "params": { "period": 14, "timeframe": "1h" },
            "op": "lt",
            "value": 30.0
          }
        ]
      },
      "exit": {
        "any_of": [
          { "type": "take_profit_pct", "value": 2.0 },
          { "type": "stop_loss_pct", "value": 1.0 }
        ]
      },
      "position_sizing": {
        "kind": "percent_portfolio",
        "value": 5.0,
        "max_notional_cents": 100000
      },
      "risk": {
        "max_concurrent": 3,
        "max_daily_loss_cents": 5000,
        "halt_after_n_losses": 4
      },
      "schedule": {
        "active_hours_utc": [[13, 21]],
        "active_days": ["Mon", "Tue", "Wed", "Thu", "Fri"]
      }
    }
  },
  {
    "id": "tpl_ema_cross",
    "name": "EMA 12/26 Crossover",
    "category": "TrendFollowing",
    "description": "Buys when EMA(12) crosses above EMA(26) on the 1h chart. Trailing stop at 0.5%.",
    "risk_level": 3,
    "asset_filter": { "symbols": [0], "market": "qftx" },
    "strategy": {
      "version": 1,
      "entry": {
        "all_of": [
          {
            "type": "indicator_threshold",
            "indicator": "ema_cross",
            "params": { "fast": 12, "slow": 26, "timeframe": "1h" },
            "op": "gt",
            "value": 0.0
          }
        ]
      },
      "exit": {
        "any_of": [
          { "type": "trailing_stop_pct", "value": 0.5 },
          { "type": "stop_loss_pct", "value": 2.0 }
        ]
      },
      "position_sizing": {
        "kind": "percent_portfolio",
        "value": 10.0,
        "max_notional_cents": 250000
      },
      "risk": {
        "max_concurrent": 2,
        "max_daily_loss_cents": 10000,
        "halt_after_n_losses": 3
      },
      "schedule": {
        "active_hours_utc": [[0, 24]],
        "active_days": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
      }
    }
  },
  {

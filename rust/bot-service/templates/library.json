  {
    "id": "tpl_grid",
    "name": "Symmetric Grid",
    "category": "Grid",
    "description": "Lays a fixed-step grid of buys below mid and sells above mid. Best in ranging markets.",
    "risk_level": 4,
    "asset_filter": { "symbols": [0], "market": "qftx" },
    "strategy": {
      "version": 1,
      "entry": {
        "all_of": [
          {
            "type": "indicator_threshold",
            "indicator": "grid_distance_pct",
            "params": { "step_pct": 0.25, "levels": 6 },
            "op": "gte",
            "value": 0.25
          }
        ]
      },
      "exit": {
        "any_of": [
          { "type": "take_profit_pct", "value": 0.5 },
